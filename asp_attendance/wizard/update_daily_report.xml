<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="update_daily_report_form_view" model="ir.ui.view">
        <field name="name">asp.update.daily.report.form.view</field>
        <field name="model">asp.update.daily.report</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <form>
                <div>
                    <div>
                        Select date to update daily report.
                    </div>
                    <group>
                        <field name="date" required="1"/>
                    </group>
                </div>
                <footer>
                    <button name="action_apply" string="Apply" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" class="btn-secondary" special="cancel" data-hotkey="z" />
                </footer>
            </form>
        </field>
    </record>
    <record id="update_daily_report_action" model="ir.actions.act_window">
        <field name="name">Update Daily Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">asp.update.daily.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="update_daily_report_form_view"/>
        <field name="target">new</field>
    </record>
</odoo>
