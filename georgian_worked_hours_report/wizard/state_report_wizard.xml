<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <record id="view_state_report_wizard_form" model="ir.ui.view">
            <field name="name">state.report.wizard.form</field>
            <field name="model">state.report.wizard</field>
            <field name="arch" type="xml">
                <form string="State Report">
                    <group>
                        <field name="generate_date"/>
                        <field name="department_id"/>
                    </group>
                    <footer>
                        <button string="Generate" type="object" name="action_generate_report" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_generate_state_report" model="ir.actions.act_window">
            <field name="name">State Report</field>
            <field name="res_model">state.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>


</odoo>
